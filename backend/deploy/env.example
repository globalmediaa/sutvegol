# backend/.env — deploy.sh ilk çalıştırmada bu dosyadan üretir ve gizli değerleri doldurur.
# İlk kurulumdan sonra APP_KEY / DB_PASSWORD / DB_ROOT_PASSWORD değerlerini değiştirme.
DOMAIN=sutvegol.gmgaming.app
APP_PORT=12883
APP_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=
GOOGLE_CLIENT_IDS=
ADMIN_EMAIL=info@globalmedia.com.tr
ADMIN_PASSWORD_HASH=

APPLE_TEAM_ID=Y2MWRALQHR
APPLE_KEY_ID=

# Nginx SSL sertifikası. Boşsa sırayla aranır:
#   /etc/ssl/cloudflare/$DOMAIN.pem + .key  (Cloudflare Origin Certificate)
#   /etc/letsencrypt/live/$DOMAIN/fullchain.pem + privkey.pem
SSL_CERT=
SSL_KEY=
